module h5vcc_memory.mojom;

interface LowMemoryListener {
  OnLowMemory();
};

// The browser process must provide an implementation of this interface so that
// the renderer process can implement the H5vccMemory Blink API.
interface H5vccMemory {
  // Register the remote LowMemoryListener.
  AddLowMemoryListener(pending_remote<LowMemoryListener> listener);
};
