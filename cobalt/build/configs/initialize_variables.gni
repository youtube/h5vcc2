# Get the path to the starboard implementation and include its GN
# configuration.

declare_args() {
  # Temporary gn arg for work on base/net update.
  cobalt_pending_clean_up = true

  build_type = "devel"

  is_internal_build = getenv("COBALT_USE_INTERNAL_BUILD") == "1"

  using_old_compiler = false

  build_with_separate_cobalt_toolchain =
      # Avoid using `is_androidtv` which uses `current_os`, so that this is also
      # false for the host toolchain.
      (target_os != "android" || is_starboard) && target_os != "ios"

  use_evergreen = false

  use_tsan = false
}

declare_args() {
  use_asan = !is_official_build && is_linux && is_cobalt_hermetic_build &&
             !use_evergreen && !use_tsan
}

# TODO(b/371589344): Investigate if we need cobalt_is_debug which
# avoids overriding chrome's is_debug.
is_devel = build_type == "devel"
is_qa = build_type == "qa"
is_gold = build_type == "gold"

# TODO(b/372141961): Investigate setting chromium flag
# is_debug = true for debug builds
# assert(is_debug || is_devel || is_qa || is_gold)

if (default_toolchain != "") {
  cobalt_toolchain = default_toolchain
} else {
  cobalt_toolchain = cobalt_toolchain_default
}

# Get the path to the starboard implementation and include its GN
# configuration.
import("//starboard/build/platform_path.gni")
declare_args() {
  starboard_toolchain = ""
  native_toolchain = ""
}

if (starboard_toolchain == "") {
  if (build_with_separate_cobalt_toolchain) {
    starboard_toolchain = "//$starboard_path/toolchain:starboard"

    # TODO(crbug.com/492403745): `native_target` toolchains should be renamed to
    # `native`.
    native_toolchain = "//$starboard_path/toolchain:native_target"
  } else {
    starboard_toolchain = cobalt_toolchain
  }
}

declare_args() {
  # True when building for an AOSP platform
  #
  # Unlike is_android, this has to stay true in the Evergreen library target,
  # where target_os is "linux".
  # This default value is true only for android toolchains, so, AOSP platforms
  # set this to true in their args.gn (see cobalt/build/configs/aosp-arm/args.gn).
  is_aosp = is_android && !is_androidtv
}

declare_args() {
  # TODO(b/428999732, b/437999182): Cobalt shell was started as a minimal test shell.
  # We use this param to separate all test logics from the Cobalt shell.
  run_browser_tests = !is_official_build
}
